# Outstatic – zufälliger geheimer String (z.B. openssl rand -hex 32)
OUTSTATIC_SECRET=

# GitHub Personal Access Token mit repo-Scope (für Outstatic Commits)
GITHUB_ACCESS_TOKEN=

# GitHub OAuth App (für Outstatic Login)
# Erstellen unter: https://github.com/settings/developers
# Callback URL: https://goethe-gymnasium-stolberg.de/outstatic/api/outstatic/callback
OST_GITHUB_ID=
OST_GITHUB_SECRET=

# Wird zur Build-Zeit benötigt (NEXT_PUBLIC_ = Client-seitig sichtbar)
NEXT_PUBLIC_OUTSTATIC_REPO_OWNER=SimonFrank14
NEXT_PUBLIC_OUTSTATIC_REPO_SLUG=ggs-docs
NEXT_PUBLIC_OUTSTATIC_REPO_BRANCH=main
