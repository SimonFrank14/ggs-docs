# ── Outstatic (Redaktion unter /outstatic) ──────────────────────────────
# Outstatic 2.x liest ausschließlich diese OST_*-Variablen, zur Laufzeit.

# GitHub OAuth App für die Anmeldung im Editor
# Anlegen unter https://github.com/settings/developers → New OAuth App
#   Homepage URL:           https://docs-neu.goethe-gymnasium-stolberg.de
#   Authorization callback: https://docs-neu.goethe-gymnasium-stolberg.de/api/outstatic/callback
OST_GITHUB_ID=
OST_GITHUB_SECRET=

# Zufälliger Schlüssel für die Sitzungen im Editor: openssl rand -hex 32
OST_TOKEN_SECRET=

# Repo, in das Outstatic committet (dasselbe Repo wie der Code)
OST_REPO_OWNER=SimonFrank14
OST_REPO_SLUG=ggs-docs
OST_REPO_BRANCH=main

# Outstatic schreibt direkt in den Inhaltsbaum der Doku
OST_CONTENT_PATH=content/docs

# Bilder aus dem Editor: Ablage im Repo und öffentliche URL
OST_REPO_MEDIA_PATH=public/images/
OST_PUBLIC_MEDIA_PATH=/images/

# ── Anmeldung im Portal (Auth.js, Konto der Schulhomepage) ──────────────
# Zufälliger Schlüssel für die Sitzungs-Cookies: openssl rand -base64 32
AUTH_SECRET=

# OAuth-Client im WordPress-Plugin „WP OAuth Server"
#   Redirect-URI: https://docs-neu.goethe-gymnasium-stolberg.de/api/auth/callback/wordpress
#   (später zusätzlich https://docs.goethe-gymnasium-stolberg.de/api/auth/callback/wordpress)
WORDPRESS_OAUTH_CLIENT_ID=
WORDPRESS_OAUTH_CLIENT_SECRET=
WORDPRESS_OAUTH_BASE_URL=https://goethe-gymnasium-stolberg.de

# Derselbe App-Schlüssel, den ggs-stundenplan für WPGraphQL schickt (X-APP-SECRET)
WORDPRESS_APP_SECRET=
